# Next's build output (JS, CSS, fonts): every file name carries a content hash, so a
# changed file gets a new name and these can be cached for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Keep their names when replaced, so not immutable: fresh for a day, then served
# from cache while the browser revalidates in the background for up to a week.
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/project_images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
